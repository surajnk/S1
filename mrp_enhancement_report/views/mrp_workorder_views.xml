    <record model="ir.ui.view" id="inherit_mrp_production_workorder_tree_editable_view_custom">
        <field name="name">inherit.mrp.production.work.order.tree.editable.custom</field>
        <field name="model">mrp.workorder</field>
        <!-- Change inherit_id to point to mrp_enhancement's view, not base mrp -->
        <field name="inherit_id" ref="mrp_enhancement.mrp_production_workorder_tree_editable_view_ext"/>
        <field name="arch" type="xml">
            <xpath expr="//tree//button[@name='%(mrp_shop_floor_control.action_set_date_wizard)d']" position="before">
                <field name="width"/>
                <field name="trim"/>
                <field name="base_avail"/>
                <field name="t_c"/>
                <field name="rod"/>
                <field name="shaded"/>
                <field name="timer_id" invisible="1"/>
            </xpath>
        </field>
    </record>
