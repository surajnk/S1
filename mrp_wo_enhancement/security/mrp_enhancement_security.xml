<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--Work center-->
        <record model="ir.rule" id="mrp_workcenter_users">
            <field name="name">MRP Workcenter Users</field>
            <field name="model_id" ref="mrp.model_mrp_workcenter"/>
            <field name="domain_force">[('id','in',user.workcenter_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>
        <record model="ir.rule" id="mrp_workcenter_manager">
            <field name="name">MRP Workcenter Manager</field>
            <field name="model_id" ref="mrp.model_mrp_workcenter"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        </record>
        <!--Work order-->
        <record model="ir.rule" id="mrp_workorder_users">
            <field name="name">MRP Workorder Users</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[('workcenter_id','in',user.workcenter_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>
        <record model="ir.rule" id="mrp_workorder_manager">
            <field name="name">MRP Workorder Manager</field>
            <field name="model_id" ref="mrp.model_mrp_workorder"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        </record>
    </data>
</odoo>
