<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="update_frame_wizard_form_view" model="ir.ui.view">
        <field name="name">update.frame.wizard.form</field>
        <field name="model">update.frame.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Frame No">
                <sheet>
                    <group>
                        <field name="frame_no" string="Frame No"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_frame_wizard" model="ir.actions.act_window">
        <field name="name">Update Frame No</field>
        <field name="res_model">update.frame.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="update_frame_wizard_form_view"/>
        <field name="target">new</field>
    </record>
</odoo>