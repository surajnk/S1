<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mail_template_crm_sample" model="mail.template">
            <field name="name">Sample Sales Quotation: Confirmation Email</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Sample Quotation: (Ref ${object.name or 'n/a' })</field>
            <field name="email_from">${(object.user_id.email_formatted or user.email_formatted) | safe}</field>
            <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 12px;">
                    Hello,
                    <br/><br/>
                    Sample Quotation  <strong>${object.quote_number}</strong> has been created by ${object.create_uid.name} .<br/>
                    <br/><br/>
                </p>
            </div></field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>