<?xml version="1.0"?>
<odoo>
        <record id="account_account_form_view_branch" model="ir.ui.view">
            <field name="name">account.account.extended.form.branch</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form" />
            <field name="arch" type="xml">
                <field name="user_type_id" position="after">
                    <field name="branch_id"/>
                </field>
            </field>
        </record>

        <record id="account_account_view_list_branch" model="ir.ui.view">
            <field name="name">account.account.view.list.branch</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_list"/>
            <field name="arch" type="xml">
                <field name="user_type_id" position="after">
                    <field name="branch_id"/>
                </field>
            </field>
        </record>

</odoo>
