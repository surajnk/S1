<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_wo_packaging_wizard_form" model="ir.ui.view">
        <field name="name">mrp.wo.packaging.wizard.form</field>
        <field name="model">mrp.wo.packaging.wizard</field>
        <field name="arch" type="xml">
            <form string="Work Order Packaging Report">
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_wo_packaging_wizard" model="ir.actions.act_window">
        <field name="name">Work Order Packaging Report</field>
        <field name="res_model">mrp.wo.packaging.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
