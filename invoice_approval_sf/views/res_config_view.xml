<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_invoice_appr_view_form" model="ir.ui.view">
            <field name="name">res.config.view.appr.form.inherit.invoice</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='account']" position="inside">
                    <h2 class="mt32">Bill Approvers</h2>
                    <div class="row mt16 o_settings_container" name="inv_tax_hide">
                        <div class="col-12 col-lg-6 o_setting_box" id="hide_tax_inv">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="inv_appr_ids"/>
                                <field name="inv_appr_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
