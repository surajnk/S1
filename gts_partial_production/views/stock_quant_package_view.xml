<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quant_package_form_add_customer_qty" model="ir.ui.view">
        <field name="name">stock.quant.package.form.add.customer.qty</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quant_ids']/tree/field[@name='quantity']" position="after">
                <field name="customer_qty"/>
                <field name="x_customer_uom_id" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>