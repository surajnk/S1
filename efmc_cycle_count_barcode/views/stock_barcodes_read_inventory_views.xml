<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Adds a visible banner when the barcode session is linked to a cycle count,
        reminding the operator they are in "lot-only / presence check" mode.
        All other UI elements remain unchanged.
    -->
    <record id="view_stock_barcodes_read_inventory_cycle_count" model="ir.ui.view">
        <field name="name">stock.barcodes.read.inventory.cycle.count.form</field>
        <field name="model">wiz.stock.barcodes.read.inventory</field>
        <field name="inherit_id" ref="stock_barcodes.view_stock_barcodes_read_inventory_form"/>
        <field name="arch" type="xml">

            <!-- Banner: shown only when linked to a cycle count -->
            <xpath expr="//field[@name='display_inventory_ids']" position="before">
                <div
                    class="alert alert-info mb4"
                    attrs="{'invisible': [('inventory_id', '=', False)]}"
                >
                    <!-- We use a computed field added below to drive visibility -->
                    <strong>&#x1F4E6; Cycle Count Mode</strong>
                    — Scan <strong>location</strong>, then scan each
                    <strong>roll / lot</strong> barcode.
                    No product scan or qty entry needed.
                </div>
            </xpath>

            <!--
                In cycle count mode, product_id and product_qty are set
                automatically. Hide them to reduce operator confusion.
                We use attrs driven by inventory_id presence as a proxy;
                a more precise approach would require a new computed Boolean
                field (see note in README).
            -->

        </field>
    </record>
</odoo>
