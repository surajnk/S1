<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="get_settlement_invoice_form_view" model="ir.ui.view">
        <field name="name">get.settlement.invoice.form.view</field>
        <field name="model">get.settlement.invoice</field>
        <field name="arch" type="xml">
            <form string="Settlement invoices">
                <field name="settlement_invoice_ids">
                    <tree editable="bottom">
                        <field name="move_id" required="1" options="{'no_create': True}"/>
                        <field name="remaining_commission_total" readonly="1" force_save="1"/>
                        <field name="amount"/>
                    </tree>
                </field>
                <footer>
                    <button name="settlement_invoice" string="Add Settlements" type="object" class="oe_highlight"/>
                    or
                    <button special="cancel" string="_Cancel" class="oe_link" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_get_settlement_invoice" model="ir.actions.act_window">
        <field name="name">Settlement invoices</field>
        <field name="res_model">get.settlement.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_get_settlement_invoice" />
    </record>

</odoo>