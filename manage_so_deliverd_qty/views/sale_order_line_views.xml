<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show field in SO line List view -->
    <record id="sale_order_form_view_inherit_custom_field" model="ir.ui.view">
        <field name="name">sale.order.form.view.inherit.show.custom.field</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_uom_qty']" position="after">
                <field name="x_order_master_yards" optional="show"/>
                <field name="qty_delivered_method" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>