<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_embossing_frame_list_tree" model="ir.ui.view">
        <field name="name">mrp.embossing.frame.list.tree</field>
        <field name="model">mrp.embossing.frame.list</field>
        <field name="arch" type="xml">
            <tree string="Embossing Frame List" create="false" edit="false" delete="false">
                <field name="frame_number" string="Fr"/>
                <field name="type" string="Ty"/>
                <field name="slot" string="Sl"/>
                <field name="pattern_id" string="Pattern"/>
                <field name="mo_number" string="MO Number"/>
                <field name="so_number" string="SO Number"/>
                <field name="status" string="Status"/>
                <field name="date_planned_start_wo" string="Scheduled Start"/>
                <field name="workcenter_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_mrp_embossing_frame_list_search" model="ir.ui.view">
        <field name="name">mrp.embossing.frame.list.search</field>
        <field name="model">mrp.embossing.frame.list</field>
        <field name="arch" type="xml">
            <search string="Embossing Frame List">
                <field name="pattern_id" string="Pattern"/>
                <field name="workcenter_id" string="Work Center"/>
                <field name="mo_number" string="MO Number"/>
                <field name="so_number" string="SO Number"/>
                <field name="date_planned_start_wo" string="Scheduled Start"/>
                <filter string="Scheduled Start" name="filter_date" date="date_planned_start_wo"/>
                <group expand="0" string="Group By">
                    <filter string="Pattern" name="group_by_pattern" context="{'group_by': 'pattern_id'}"/>
                    <filter string="Work Center" name="group_by_workcenter" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mrp_embossing_frame_list" model="ir.actions.act_window">
        <field name="name">Embossing Frame List</field>
        <field name="res_model">mrp.embossing.frame.list</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_mrp_embossing_frame_list_search"/>
    </record>

    <menuitem
        id="menu_mrp_embossing_frame_list"
        name="Embossing Frame List"
        sequence="65"
        parent="mrp.menu_mrp_reporting"
        action="action_mrp_embossing_frame_list"
        groups="mrp.group_mrp_user"/>

</odoo>
