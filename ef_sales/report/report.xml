<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_mrp_so" model="report.paperformat">
        <field name="name">SO report A3</field>
        <field name="default" eval="True"/>
        <field name="format">A3</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">80</field>
    </record>

    <record id="paperformat_custom_so" model="report.paperformat">
        <field name="name">SO-report A3</field>
        <field name="default" eval="True"/>
        <field name="format">A3</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="dpi">80</field>
    </record>

    <record id="action_report_price_quotation" model="ir.actions.report">
        <field name="name">Price Quotation</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ef_sales.report_price_quotation</field>
        <field name="report_file">ef_sales.report_price_quotation</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ef_sales.paperformat_mrp_so"/>
        <field name="print_report_name">'Price Quotation - %s' % (object.name)</field>
    </record>

    <record id="action_report_price_confirmed_quotation" model="ir.actions.report">
        <field name="name">ORDER CONFIRMATION</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ef_sales.report_price_confirmed_quotation</field>
        <field name="report_file">ef_sales.report_price_confirmed_quotation</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ef_sales.paperformat_mrp_so"/>
        <field name="print_report_name">'Order Confirmation - %s' % (object.name)</field>
    </record>

    <record id="action_report_sale_custom_order" model="ir.actions.report">
        <field name="name">SALES ORDER</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ef_sales.report_sales_custom</field>
        <field name="report_file">ef_sales.report_sales_custom</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ef_sales.paperformat_custom_so"/>
        <field name="print_report_name">'Sales Order - %s' % (object.name)</field>
    </record>


</odoo>