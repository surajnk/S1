<odoo>
    <template id="report_sale_report_wizard1">
        <t t-call="web.html_container">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Times+New+Roman&amp;display=swap');
                table th{
                font-family:Times New Roman;
                font-size: 10pt;
                text-align:center;
                padding-top:8px;
                padding-bottom:8px;
                }
                table td{
                font-family:Times New Roman;
                font-size: 10pt;
                padding-top:8px;
                padding-bottom:8px;
                text-align:center;
                }
                .dat_table td{
                font-family:Times New Roman;
                font-size: 14pt;
                padding-top:8px;
                padding-bottom:8px;
                text-align:right;
                }
                .dat_table th{
                font-family:Times New Roman;
                font-size: 14pt;
                padding-top:8px;
                padding-bottom:8px;
                text-align:right;
                }
            </style>
            <div class="header">
                <table width="100%">
                    <tr>
                        <td width="20%" style=" font-family:Times New Roman;">
                            <strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d,%Y')"/>
                            </strong>
                        </td>
                        <td style="text-align:center; font-family:Times New Roman;">
                            <strong>
                                Ecological Fiber, Inc
                            </strong>
                        </td>
                        <td style="text-align:right; font-family:Times New Roman;">
                            <strong>
                                Page
                                <span class="page"/>
                            </strong>
                        </td>
                    </tr>
                    <tr>
                        <td style=" font-family:Times New Roman;">
                            <strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M:%S')"/>
                            </strong>
                        </td>
                        <td style="text-align:center; font-family:Times New Roman;">
                            <strong>
                                Sales By Salesperson
                            </strong>
                        </td>
                        <td>

                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align:center; font-family:Times New Roman;">
                            <strong>
                                For Month Ended :
                                <span t-esc="formatted_end_date"/>
                            </strong>
                        </td>
                    </tr>
                </table>

            </div>
            <page>

                <table width="100%" class="dat_table">
                    <thead>
                        <tr>
                            <th style="text-align:left !important;">Sales Rep</th>
                            <th>
                                <span t-esc="formatted_end_date"/>
                            </th>
                            <th>
                                <span t-esc="cytd_end_date"/>
                            </th>
                            <th>
                                <span t-esc="prev_end_date"/>
                            </th>
                            <th>
                                <span t-esc="prev_cytd_end_date"/>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="ct" t-value="0"/>
                        <t t-set="yct" t-value="0"/>
                        <t t-set="pt" t-value="0"/>
                        <t t-set="ypt" t-value="0"/>
                        <t t-foreach="combined_report" t-as="line">
                            <tr>
                                <td style="text-align:left !important;">
                                    <t t-esc="line['name']"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['current_year_total'])"/>
                                    <t t-set="ct" t-value="ct+line['current_year_total']"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['current_ytd_total'])"/>
                                    <t t-set="yct" t-value="yct+line['current_ytd_total']"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['previous_year_total'])"/>
                                    <t t-set="pt" t-value="pt+line['previous_year_total']"/>
                                </td>
                                <td>
                                    <t t-esc="'{:,.2f}'.format(line['previous_ytd_total'])"/>
                                    <t t-set="ypt" t-value="ypt+line['previous_ytd_total']"/>
                                </td>
                            </tr>
                        </t>

                        <tr style="">
                            <td style="text-align:left !important;">
                                <em>
                                    <strong>Grand Total</strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(ct)"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(yct)"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(pt)"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(ypt)"/>
                                    </strong>
                                </em>
                            </td>
                        </tr>


                    </tbody>
                </table>

                <p style="page-break-before:always;"/>
            </page>
        </t>
    </template>


    <record id="report_qweb_sale_paperformat" model="report.paperformat">
        <field name="name">Sale paperformat</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>


    <record id="report_sale_report_wizard2" model="ir.actions.report">
        <field name="name">Sale Report</field>
        <field name="model">sale.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ef_sales.report_sale_report_wizard1</field>
        <field name="report_file">ef_sales.report_sale_report_wizard1</field>
        <field name="paperformat_id" ref="report_qweb_sale_paperformat"/>
        <!--        <field name="print_report_name">Sale Report</field>-->
    </record>
</odoo>