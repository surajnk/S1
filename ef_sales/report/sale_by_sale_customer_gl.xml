<odoo>
    <template id="report_report_sale_customer_gl">
        <t t-call="web.html_container">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Times+New+Roman&amp;display=swap');
                table th{
                font-family:Times New Roman;
                font-size: 10pt;
                text-align:center;
                padding-top:8px;
                padding-bottom:8px;
                }
                table td{
                font-family:Times New Roman;
                font-size: 10pt;
                padding-top:8px;
                padding-bottom:8px;
                text-align:center;
                }
                .dat_table td{
                font-family:Times New Roman;
                font-size: 14pt;
                padding-top:8px;
                padding-bottom:8px;
                text-align:right;
                }
                .dat_table th{
                font-family:Times New Roman;
                font-size: 14pt;
                padding-top:8px;
                padding-bottom:8px;
                text-align:right;
                }
            </style>
            <div class="header">
                <table width="100%">
                    <tr>
                        <td width="20%" style=" font-family:Times New Roman;">
                            <strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d,%Y')"/>
                            </strong>
                        </td>
                        <td style="text-align:center; font-family:Times New Roman;">
                            <strong>
                                Ecological Fiber, Inc
                            </strong>
                        </td>
                        <td style="text-align:right; font-family:Times New Roman;">
                            <strong>
                                Page
                                <span class="page"/>
                            </strong>
                        </td>
                    </tr>
                    <tr>
                        <td style=" font-family:Times New Roman;">
                            <strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M:%S')"/>
                            </strong>
                        </td>
                        <td style="text-align:center; font-family:Times New Roman;">
                            <strong>
                                Sales By Salesperson/Customer/GL Category
                            </strong>
                        </td>
                        <td>

                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="text-align:center; font-family:Times New Roman;">
                            <strong>
                                For Month Ended :
                                <span t-esc="formatted_end_date"/>
                            </strong>
                        </td>
                    </tr>
                </table>

            </div>
            <page>

                <table width="100%" class="dat_table">
                    <thead>
                        <tr>
                            <th style="text-align:left !important;">Sales Rep</th>
                            <th>
                                <span t-esc="formatted_end_date"/>
                            </th>
                            <th>
                                <span t-esc="cytd_end_date"/>
                            </th>
                            <th>
                                <span t-esc="prev_end_date"/>
                            </th>
                            <th>
                                <span t-esc="prev_cytd_end_date"/>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" style="text-align:left !important;">
                                <strong>
                                    <span t-esc="salesperson"/>
                                </strong>
                            </td>
                        </tr>
                        <t t-set="ct" t-value="0"/>
                        <t t-set="yct" t-value="0"/>
                        <t t-set="pt" t-value="0"/>
                        <t t-set="ypt" t-value="0"/>
                        <t t-foreach="combined_report" t-as="line">
                            <tr>
                                <td colspan="5" style="text-align:left !important;">
                                    <strong>
                                        <t t-esc="line['customer']"/>
                                    </strong>
                                </td>
                            </tr>
                            <t t-set="cct" t-value="0"/>
                            <t t-set="cyct" t-value="0"/>
                            <t t-set="cpt" t-value="0"/>
                            <t t-set="cypt" t-value="0"/>
                            <t t-foreach="line['products']" t-as="p">
                                <tr>
                                    <td style="text-align:left !important;">
                                        <t t-esc="p['product']"/>
                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(p['current_year_total'])"/>
                                        <t t-set="ct" t-value="ct+p['current_year_total']"/>
                                        <t t-set="cct" t-value="cct+p['current_year_total']"/>
                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(p['current_ytd_total'])"/>
                                        <t t-set="yct" t-value="yct+p['current_ytd_total']"/>
                                        <t t-set="cyct" t-value="cyct+p['current_ytd_total']"/>
                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(p['previous_year_total'])"/>
                                        <t t-set="pt" t-value="pt+p['previous_year_total']"/>
                                        <t t-set="cpt" t-value="cpt+p['previous_year_total']"/>
                                    </td>
                                    <td>
                                        <t t-esc="'{:,.2f}'.format(p['previous_ytd_total'])"/>
                                        <t t-set="ypt" t-value="ypt+p['previous_ytd_total']"/>
                                        <t t-set="cypt" t-value="cypt+p['previous_ytd_total']"/>
                                    </td>
                                </tr>
                            </t>
                            <tr style="">
                                <td style="text-align:left !important;">
                                    <em>
                                        <strong>Customer Total :
                                        </strong>
                                    </em>
                                </td>
                                <td style="border-top:1px dashed black;">
                                    <em>
                                        <strong>
                                            <span t-esc="'{:,.2f}'.format(cct)"/>
                                        </strong>
                                    </em>
                                </td>
                                <td style="border-top:1px dashed black;">
                                    <em>
                                        <strong>
                                            <span t-esc="'{:,.2f}'.format(cyct)"/>
                                        </strong>
                                    </em>
                                </td>
                                <td style="border-top:1px dashed black;">
                                    <em>
                                        <strong>
                                            <span t-esc="'{:,.2f}'.format(cpt)"/>
                                        </strong>
                                    </em>
                                </td>
                                <td style="border-top:1px dashed black;">
                                    <em>
                                        <strong>
                                            <span t-esc="'{:,.2f}'.format(cypt)"/>
                                        </strong>
                                    </em>
                                </td>
                            </tr>
                        </t>
                        <tr style="">
                            <td style="text-align:left !important;">
                                <em>
                                    <strong>Total For :
                                        <span t-esc="salesperson"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(ct)"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(yct)"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(pt)"/>
                                    </strong>
                                </em>
                            </td>
                            <td style="border-top:1px dashed black;">
                                <em>
                                    <strong>
                                        <span t-esc="'{:,.2f}'.format(ypt)"/>
                                    </strong>
                                </em>
                            </td>
                        </tr>


                    </tbody>
                </table>

                <p style="page-break-before:always;"/>
            </page>
        </t>
    </template>
    <record id="report_sale_customer_gl" model="ir.actions.report">
        <field name="name">Sale Report</field>
        <field name="model">sale.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ef_sales.report_report_sale_customer_gl</field>
        <field name="report_file">ef_sales.report_report_sale_customer_gl</field>
        <field name="paperformat_id" ref="ef_sales.report_qweb_sale_paperformat"/>
        <!--        <field name="print_report_name">Sale Report</field>-->
    </record>
</odoo>