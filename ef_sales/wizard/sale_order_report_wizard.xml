<odoo>

    <record id="view_report_wizard_form" model="ir.ui.view">
        <field name="name">ale.repirt.wizard.form</field>
        <field name="model">sale.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Job Allocation Report">
                <sheet>
                    <group>
                        <group>
                <field name="start_date"/>
                <field name="user_id"
                       attrs="{'required' : [('report_type', 'in' , ('spc','spg'))],'invisible' : [('report_type', 'not in' , ('spc','spg'))]}"/>
                <field name="manager_id"
                       attrs="{'required' : [('report_type', 'in' , ('spa'))],'invisible' : [('report_type', 'not in' , ('spa'))]}"/>
                <field name="report_type" invisible="1"/>
                <field name="is_excel_report" invisible="1"/>
            </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="print_report" string="Print" type="object" class="oe_highlight"
                            attrs="{'invisible': [('report_type', '!=', 'sp')]}"/>
                    <button name="print_report_spc" string="Print" type="object" class="oe_highlight"
                            attrs="{'invisible': [('report_type', '!=', 'spc')]}"/>
                    <button name="print_report_spg" string="Print" type="object" class="oe_highlight"
                            attrs="{'invisible': [('report_type', '!=', 'spg')]}"/>
                    <button name="print_report_spa" string="Print" type="object" class="oe_highlight"
                            attrs="{'invisible': [('report_type', '!=', 'spa')]}"/>
                    <button name="print_report_ac" string="Print" type="object" class="oe_highlight"
                            attrs="{'invisible': [('report_type', '!=', 'ac')]}"/>
                    <button name="print_report_excel" string="Print" type="object" class="oe_highlight"
                            attrs="{'invisible': [('is_excel_report', '!=', True)]}"/>

                    <button string="Cancel" special="cancel" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sale_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales by Salesperson</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ef_sales.view_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context" eval="{'default_report_type':'sp'}"/>
    </record>
    <record id="action_sale_customer_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales by Salesperson / Customer</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ef_sales.view_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context" eval="{'default_report_type':'spc'}"/>
    </record>
    <record id="action_sale_customer_gl_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales by Salesperson / Customer / GL Category</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ef_sales.view_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context" eval="{'default_report_type':'spg'}"/>
    </record>
    <record id="action_sale_by_acount_mgr" model="ir.actions.act_window">
        <field name="name">Sales by Account Mgr</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ef_sales.view_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context" eval="{'default_report_type':'ac'}"/>
    </record>
    <record id="action_sale_customer_gl_ac_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales by Account Mgr / Salesperson / Customer / GL Category</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ef_sales.view_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context" eval="{'default_report_type':'spa'}"/>
    </record>

    <record id="action_sale_excel" model="ir.actions.act_window">
        <field name="name">Sales Excel Report</field>
        <field name="res_model">sale.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ef_sales.view_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context" eval="{'default_is_excel_report':True}"/>
    </record>
    <record id="xlsx_report_generate_sale" model="ir.actions.report">
        <field name="name">Sale Report</field>
        <field name="model">sale.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ef_sales.print_sale_report_excel</field>
        <field name="report_file">ef_sales.print_sale_report_excel</field>
    </record>
    <menuitem id="sale_report_wizard_menu"
              name="Sales by Salesperson"
              parent="sale.menu_sale_report"
              action="action_sale_report_wizard" sequence="2"
    />
    <menuitem id="sale_report_customer_wizard_menu"
              name="Sales by Salesperson / Customer"
              parent="sale.menu_sale_report"
              action="action_sale_customer_report_wizard" sequence="3"
    />
    <menuitem id="sale_report_customer_gl_wizard_menu"
              name="Sales by Salesperson / Customer/ GL Category"
              parent="sale.menu_sale_report"
              action="action_sale_customer_gl_report_wizard" sequence="4"
    />
    <menuitem id="sale_report_customer_gl_ac_wizard_menu"
              name="Sales by Account Mgr / Salesperson / Customer / GL Category"
              parent="sale.menu_sale_report"
              action="action_sale_customer_gl_ac_report_wizard" sequence="4"
    />
    <menuitem id="sale_report_customer_ac_menu"
              name="Sales by Account Mgr"
              parent="sale.menu_sale_report"
              action="action_sale_by_acount_mgr" sequence="6"
    />
    <menuitem id="sale_report_customer_excel"
              name="Sales Excel Report"
              parent="sale.menu_sale_report"
              action="action_sale_excel" sequence="7"
    />
</odoo>