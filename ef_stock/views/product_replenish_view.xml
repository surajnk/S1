<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_replenish_remove_uom_domain" model="ir.ui.view">
        <field name="name">product.replenish.remove.uom.domain</field>
        <field name="model">product.replenish</field>
        <field name="inherit_id" ref="stock.view_product_replenish"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
