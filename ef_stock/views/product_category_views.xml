<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_tow_user_form" model="ir.ui.view">
        <field name="name">product.category.tow.user.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="TOW Configuration">
                    <field name="tow_user_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>