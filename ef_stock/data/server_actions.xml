<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="action_recompute_tow_user" model="ir.actions.server">
        <field name="name">Recompute TOW User on Pickings</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">
            pickings = env['stock.picking'].search([('state', 'not in', ['done', 'cancel'])])
            pickings._compute_tow_user_id()
        </field>
    </record>

    <record id="cron_recompute_tow_user" model="ir.cron">
        <field name="name">Recompute TOW User on Pickings</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">
pickings = env['stock.picking'].search([('state', 'not in', ['done', 'cancel'])])
pickings._compute_tow_user_id()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">1</field>
        <field name="active">False</field>
    </record>
</odoo>
