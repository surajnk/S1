<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- tree` -->
        <record id="project_material_request_tree" model="ir.ui.view">
            <field name="name">Material Request</field>
            <field name="model">project.mrequest</field>
            <field name="arch" type="xml">
                <tree string="Material Request">
                    <field name="name"/>
                    <field name="production_id"/>
                    <field name="date_of_request"/>
                    <field name="workcenter_id"/>
                    <field name="create_uid"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <!-- form -->
        <record id="project_material_request_form" model="ir.ui.view">
            <field name="name">Material Request</field>
            <field name="model">project.mrequest</field>
            <field name="arch" type="xml">
                <form string="Material Request">
                    <header>
                        <button name="create_rfq" type="object" string="Create Rfq" class="oe_highlight"
                                groups="mrequest.group_mrequest_purchase"/>

                        <button name="draft" type="object" string="Send Request" class="oe_highlight" groups=""
                                states="approved"/>
                        <button name="request" type="object" string="Send Request" class="oe_highlight" groups=""
                                states="draft"/>
                        <button name="reject" type="object" string="Rejected" class="oe_highlight" groups=""
                                states="request"/>
                        <!-- <button name="approve" type="object" string="Approved" class="oe_highlight" groups=""
                                states="request"/> -->
                        <button name="delivery" type="object" string="Material delivered" class="oe_highlight" groups=""
                                states="request"/>
                        <!-- <button name="done" type="object" string="Done" class="oe_highlight" groups=""
                                states="delivery"/> -->

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,request,reject,done" readonly="1"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- <button class="oe_stat_button" type="object" name="get_po" icon="fa-pencil-square-o">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Quotation(s)</span>
                                </div>
                            </button> -->
                            <button name="action_view_mop_delivery" string="Stock Transfers" type="object" icon="fa-pencil-square-o" class="oe_highlight" groups="base.group_user" attrs="{'invisible': [('production_id', '=', False)]}"/>
                        </div>
                        <group>
                            <group>
                                <field name="name" class="oe_highlight"/>
                                <field name="production_id"/>
                                <field name="project_id" attrs="{'readonly':[('state','!=','draft')]}"
                                       options="{'no_create':True, 'no_edit':True, 'no_open':True}" invisible="1"/>
                                <field name="task_id" invisible="1" attrs="{'readonly':[('state','!=','draft')]}"
                                       domain="[('project_id','=',project_id)]"
                                       options="{'no_create':True, 'no_edit':True, 'no_open':True}"/>
                                <field name="suggested_vendore" invisible="1"
                                       attrs="{'readonly':[('state','!=','draft')]}"/>
                            </group>
                            <group>
                                <field name="date_of_request" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="workcenter_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="date_deadline" invisible="1"
                                       attrs="{'readonly':[('state','!=','draft')]}"/>

                                <field name="user_id" invisible="1" attrs="{'readonly':[('state','!=','draft')]}"/>

                            </group>
                        </group>
                        <notebook>
                            <page string="Materials">
                                <field name="mrequest_lines" attrs="{'readonly':[('state','!=','draft')]}">
                                    <tree editable="bottom">
                                        <field name="product"
                                               options="{'no_create':True, 'no_edit':True, 'no_open':True}"/>
                                        <field name="description"/>
                                        <field name="unit"/>
                                        <field name="quantity"/>
                                        <field name="quantity_available"/>
                                        <field name="done_quantity" sum="Total Done Quantity"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="o_attachment_preview"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- activity view -->
        <record id="project_material_request_activity" model="ir.ui.view">
            <field name="name">Material Request</field>
            <field name="model">project.mrequest</field>
            <field name="arch" type="xml">
                <activity string="Material Request">
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <!-- <field name="code" display="full"/> -->
                                <field name="name" muted="1" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <record id="project_material_request_kanban" model="ir.ui.view">
            <field name="name">Material Request Kanban</field>
            <field name="model">project.mrequest</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_example">
                    <field name="name"/>
                    <field name="date_of_request"/>
                    <field name="production_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record">
                                    <div>
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div>
                                        <span>Created by:
                                            <field name="create_uid"/>
                                        </span>
                                    </div>

                                    <div>
                                        <span>Date of Request: <field name="date_of_request"/></span>
                                    </div>
                                    <div>
                                        <span>Production ID: <field name="production_id"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- action -->
        <record id="project_material_request_action" model="ir.actions.act_window">
            <field name="name">Material Request</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.mrequest</field>
            <field name="view_mode">tree,form,activity</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <record id="project_mrequest_view_search" model="ir.ui.view">
            <field name="name">project.mrequest.search</field>
            <field name="model">project.mrequest</field>
            <field name="arch" type="xml">
                <search string="Material Request Search">
                    <field name="name"/>
                    <field name="production_id"/>
                    <field name="date_of_request"/>
                    <field name="create_uid"/>
                    <field name="state"/>
                    <filter string="My Material Request" name="my_maintenances" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <separator/>
                    <filter invisible="1" string="Late Activities" name="activities_overdue"
                        domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter invisible="1" string="Today Activities" name="activities_today"
                        domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter invisible="1" string="Future Activities" name="activities_upcoming_all"
                        domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                </search>
            </field>
        </record>


        <!-- menu in project -->
        <menuitem id="menu_main_project_mrequest" name="Material Request" parent="mrp.menu_mrp_root" sequence="4"/>
        <menuitem id="menu_project_mrequest" name="Material Request" parent="menu_main_project_mrequest"
                  action="project_material_request_action" sequence="1"/>

        <menuitem id="menu_inventory_mrequest" name="Material Request" parent="stock.menu_stock_root"
                  action="project_material_request_action" sequence="1"/>

    </data>
</odoo>