<odoo>
    <record id="view_manufacturing_workorder_filter_wizard_form" model="ir.ui.view">
        <field name="name">manufacturing.workorder.filter.wizard.form</field>
        <field name="model">manufacturing.workorder.filter.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Work Orders">
                <sheet>
                    <group>
                        <field name="manufacture_id" required="1" options="{'no_create_edit': True, 'no_create': True}"/>
                        <field name="workcenter_id"
                               options="{'no_create_edit': True, 'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_search_workorders" string="Search" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="search_mrp_workorder">
        <field name="name">Search Work Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">manufacturing.workorder.filter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_manufacturing_workorder_filter_wizard_form"/>
    </record>


    <menuitem id="menu_search_mrp_workorder"
                name="Search Work Orders"
                action="search_mrp_workorder"
                sequence="10"/>

</odoo>