<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Mrp Bom Form View to Modify it -->
        <record id="mrp_bom_inherit_form_view" model="ir.ui.view">
            <field name="name">mrp.bom.inherit.form.view</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='operation_ids']" position="attributes">
                    <attribute name="context">{
                        'bom_id_invisible': True,
                        'default_company_id': company_id,
                        'default_product_tmpl_ids': [product_tmpl_id],
                        'default_from_exist_workcenter': True}
                    </attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>