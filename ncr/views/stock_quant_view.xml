<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Highlight rows whose lot is part of an open NCR in the stock on hand lists -->
    <record id="view_stock_quant_tree_editable_ncr_lot" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.ncr.lot</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="decoration-danger">lot_in_ncr</attribute>
            </tree>
            <field name="lot_id" position="after">
                <field name="lot_in_ncr" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_ncr_lot" model="ir.ui.view">
        <field name="name">stock.quant.tree.ncr.lot</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <!-- apply after product_expiry, which also sets decoration-danger on this tree -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="decoration-danger">lot_in_ncr or quantity &lt; 0</attribute>
            </tree>
            <field name="lot_id" position="after">
                <field name="lot_in_ncr" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Filter on lots that are part of an open NCR -->
    <record id="search_product_lot_filter_ncr" model="ir.ui.view">
        <field name="name">stock.production.lot.search.ncr</field>
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <filter name="in_ncr" string="In Open NCR" domain="[('in_ncr', '=', True)]"/>
                <separator/>
            </field>
        </field>
    </record>

</odoo>
