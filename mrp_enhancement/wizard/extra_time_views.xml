<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="extra_time_form_view" model="ir.ui.view">
        <field name="name">extra.time.form</field>
        <field name="model">extra.time</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div style="margin-top:10px;">
                            <widget name="web_ribbon" text="Started"
                                    attrs="{'invisible': [('task_timer', '=', False)]}"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="workorder_id" invisible="1"/>
                            <field name="task_timer" widget="boolean_toggle" invisible="1"/>
                            <field name="is_user_working" invisible="1"/>
                            <field name="setup_time" id="duration" widget="extra_timer" force_save="1"/>
                            <field name="current_setupime" widget="float_time" invisible="1"/>
                            <field name="extra_line_id" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Start" type="object" name="start_timere" class="btn-primary"
                                attrs="{'invisible': [('task_timer', '=', True)]}"/>
                        <button name="add_time" type="object" string="Finish" class="btn-primary"
                                attrs="{'invisible': [('task_timer', '=', False)]}"/>
                        <button string="Skip" type="object" name="action_skip" class="btn btn-secondary"/>
                        <button string="Close" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
