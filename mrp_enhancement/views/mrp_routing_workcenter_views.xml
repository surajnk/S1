<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_routing_workcenter_move_wc" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.move.wc</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//form//group[@name='description']" position="replace">
                <group name="description">
                    <field name="workcenter_id" context="{'default_company_id': company_id, 'set_exist_wc': '1'}"/>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="bom_id" invisible="context.get('bom_id_invisible', False)"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="mrp_routing_workcenter_remove_add_exist_wc" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.add.exist.wc</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp_enhancement.mrp_routing_workcenter_move_wc" />
        <field name="arch" type="xml">
            <field name="workcenter_id" position="after">
                <field name="from_exist_workcenter" invisible="1"/>
                <field name="exist_workcenter_id"
                    attrs="{'invisible': [('from_exist_workcenter', '!=', True)]}"
                    domain="[('workcenter_id', '=', workcenter_id),('bom_id', '=', False)]"
                />
            </field>
        </field>
    </record>

</odoo>