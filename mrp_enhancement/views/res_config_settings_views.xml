<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_allowance_notifiers" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.allowance.notifiers</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='mrp']" position="inside">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="allowance_notifier_user_ids" string="Allowance notifiers"/>
                            <div class="text-muted">
                                Select the users that should receive an email when a manufacturing order produces less than its allowance threshold.
                            </div>
                            <field name="allowance_notifier_user_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                        </div>
                    </div>
                </div>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pc_split_by_operation"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pc_split_by_operation"/>
                            <div class="text-muted">
                                Create one Pick Components transfer per first operation under the BOM lines' Multiple Operations, going to that operation's workcenter location.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
