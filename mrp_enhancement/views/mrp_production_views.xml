<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="mrp_production_workorder_tree_editable_view_ext" model="ir.ui.view">
        <field name="name">mrp.production.work.order.tree.mid.point.sche</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp_shop_floor_control.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">

            <!-- EXISTING: Add Mid Point Scheduling buttons -->
            <xpath expr="//tree//button[@name='action_open_wizard']" position="before">
                <button name="%(mrp_shop_floor_control.action_set_date_wizard)d" type="action"
                        string="Mid Point Scheduling" class="btn-primary" groups="mrp_enhancement.group_mrp_mps"/>
                <button name="action_open_operation_description" type="object"
                        class="fa fa-info-circle" groups="mrp_enhancement.group_mrp_mps"/>
            </xpath>

            <!-- EXISTING: Rename buttons to wiz variants -->
            <xpath expr="//tree//button[@name='button_start']" position="attributes">
                <attribute name="name">button_start_wiz</attribute>
            </xpath>
            <xpath expr="//tree//button[@name='button_finish']" position="attributes">
                <attribute name="name">button_stop_wiz</attribute>
            </xpath>
            <xpath expr="//tree//button[@name='button_pending']" position="attributes">
                <attribute name="string">Stop</attribute>
                <attribute name="name">button_pending_wiz</attribute>
            </xpath>

            <!-- EXISTING: Add total_final_yards_qty field -->
            <xpath expr="//tree//field[@name='total_produce_quantity']" position="after">
                <field name="total_final_yards_qty" optional="show"/>
            </xpath>

            <!-- NEW: Remove all action buttons from right side (empty replace = delete) -->
            <xpath expr="//tree//button[@name='button_start_wiz']" position="replace"/>
            <xpath expr="//tree//button[@name='button_pending_wiz']" position="replace"/>
            <xpath expr="//tree//button[@name='button_stop_wiz']" position="replace"/>
            <xpath expr="//tree//button[@name='339']" position="replace"/>
            <xpath expr="//tree//button[@name='button_unblock']" position="replace"/>

            <!-- NEW: Move status field - remove from current position -->
            <xpath expr="//tree//field[@name='state']" position="replace"/>

            <!-- NEW: Re-insert status + all buttons before first field (leftmost) -->
            <xpath expr="//tree/field[1]" position="before">
                <field name="state" widget="badge"
                    decoration-success="state == 'done'"
                    decoration-warning="state == 'progress'"
                    decoration-info="state not in ('done', 'cancel', 'progress')"/>
                <button name="button_start_wiz" type="object" string="Start" class="btn-success"
                    attrs="{'invisible': ['|', '|', '|',
                        ('production_state','in', ('draft', 'done')),
                        ('working_state', '=', 'blocked'),
                        ('state', '=', 'done'),
                        ('is_user_working', '!=', False)]}"/>
                <button name="button_pending_wiz" type="object" string="Stop" class="btn-warning"
                    attrs="{'invisible': ['|', '|',
                        ('production_state', 'in', ('draft', 'done')),
                        ('working_state', '=', 'blocked'),
                        ('is_user_working', '=', False)]}"/>
                <button name="button_stop_wiz" type="object" string="Done" class="btn-success"
                    attrs="{'invisible': ['|', '|',
                        ('production_state', 'in', ('draft', 'done')),
                        ('working_state', '=', 'blocked'),
                        ('is_user_working', '=', False)]}"/>
                <button name="339" type="action" string="Block"
                    context="{'default_workcenter_id': workcenter_id}" class="btn-danger"
                    attrs="{'invisible': ['|',
                        ('production_state', 'in', ('draft', 'done')),
                        ('working_state', '=', 'blocked')]}"/>
                <button name="button_unblock" type="object" string="Unblock"
                    context="{'default_workcenter_id': workcenter_id}" class="btn-danger"
                    attrs="{'invisible': ['|',
                        ('production_state', 'in', ('draft', 'done')),
                        ('working_state', '!=', 'blocked')]}"/>
            </xpath>

        </field>
    </record>
