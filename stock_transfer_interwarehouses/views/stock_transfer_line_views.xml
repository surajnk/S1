<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_stock_transfer_line_interwarehouses_pivot" model="ir.ui.view">
        <field name="name">stock.transfer.line.pivot</field>
        <field name="model">stock.transfer.line</field>
        <field name="arch" type="xml">
            <pivot string="Stock Transfer Lines">
                <field name="date_planned" interval="month" type="col"/>
                <field name="product_id" type="row"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="qty_delivered" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_transfer_line_interwarehouses_search" model="ir.ui.view">
        <field name="name">stock.transfer.line.search</field>
        <field name="model">stock.transfer.line</field>
        <field name="arch" type="xml">
            <search string="Stock Transfer">
                <field name="name"/>
                <filter string="Draft" name="ready" domain="[('state','=','draft')]"/>
                <filter string="Open" name="open" domain="[('state','in',('draft','confirm','progress'))]"/>
                <filter string="Closed" name="done" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <record id="action_stock_transfer_line_interwarehouses" model="ir.actions.act_window">
        <field name="name">Stock Transfer Lines</field>
        <field name="res_model">stock.transfer.line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">pivot</field>
        <field name="context">{'search_default_done': True}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
        id="menu_stock_transfer_line_interwarehouses"
        action="action_stock_transfer_line_interwarehouses"
        name="Stock Transfer Lines Interwarehouses"
        parent="stock.menu_warehouse_report"
        sequence="120"
        groups="stock.group_stock_user"/>
</odoo>