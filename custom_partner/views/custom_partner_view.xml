<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="custom_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="ref"/>
            </xpath>
        </field>
    </record>

    <record id="custom_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        name="action_view_partner_payments"
                        context="{'default_partner_id': active_id}">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field name="currency_id" invisible="1"/>
                            <field name="x_customer_credits" widget='monetary'
                                   options="{'currency_field': 'currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Balance</span>
                    </div>
                </button>
            </div>
            <xpath expr="/form/*" position="before">
                <header>
                    <button name="copy_contacts" type="object" string="Apply Notes to Sub-Contacts"
                            class="oe_highlight"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='vat']" position="before">

                <field name="x_country_code"/>
                <field name="x_currency_id"/>
                <field name="x_language"/>
                <!--  <field name="x_territory"/> -->
                <!--   <field name="x_jurisdiction"/>  -->
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">

                <field name="x_gst" placeholder="e.g. 22 AAAAA0000A"/>
                <field name="x_pst" placeholder="PST"/>

            </xpath>
            <xpath expr="//field[@name='mobile']" position="after">

                <field name="x_fax" placeholder="FAX"/>

            </xpath>
            <!--                 <xpath expr="//notebook/page[@name='sales_purchases']/group[@name='container_row_2']/group[@name='sale']/field[@name='user_id']" position="before">
                                  <field name="x_salesrep_domain" invisible="1"/>
                                  <field name="user_id" domain="x_salesrep_domain" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'m2o_dialog':False}"/>
                            </xpath> -->
            <!--                   <xpath expr="//field[@name='user_id']" position="before">
                                <field name="x_salesrep_domain"/>
                                <field name="user_id" domain="x_salesrep_domain"/>
                                  <attribute name="domain">x_salesrep_domain</attribute>
                              </xpath> -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="x_assigned_csr"/>
                <field name="x_salesrep_domain" invisible="1"/>
                <field name="user_id" domain="x_salesrep_domain" invisible="1"/>
                <field name="x_ap_contact"/>
                <field name="x_domain_portal" invisible="1"/>
                <field name="x_manager" domain="x_domain_portal"
                       options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'m2o_dialog':False}"/>
                <field name="x_sales_off"
                       options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'m2o_dialog':False}"/>
                <field name="x_special_pricing"/>

            </xpath>

            <xpath expr="//field[@name='industry_id']" position="after">

                <field name="x_freight_terms"
                       options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'m2o_dialog':False}"/>
                <field name="x_delinquent_days"/>
                <field name="x_credit_limit"/>
                <field name="x_outturns"/>
                <field name="x_dupe_po"/>


            </xpath>


            <xpath expr="//notebook/page[@name='sales_purchases']//group[2]" position="after">
                <group string="Shipping &amp;  Other Details" name="shipping" priority="2">
                    <field name="x_ship_via"
                           options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'m2o_dialog':False}"/>
                    <field name="x_shipper_acct"/>
                    <field name="x_email_invoice"/>
                    <field name="x_mail_invoice"/>
                    <field name="x_hold_shipment"/>
                    <field name="x_plain_label"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='industry_id']" position="replace">
                <field name="industry_id" string="Class Of Trade"/>
            </xpath>
            <xpath expr="//field[@name='state_id']" position="replace">
                <field name="state_id" class="o_address_state" placeholder="Territory"
                       options="{'no_open': True, 'no_quick_create': True}"
                       context="{'default_country_id': country_id}"/>
            </xpath>

            <xpath expr="//notebook/page[@name='sales_purchases']" position="after">
                <page string="Customer Notes" name="cust_notes">
                    <group string="Notes">
                        <field name="x_customer_notes" string="Customer Notes"/>
                    </group>
                </page>
                <page string="Quantity Breaks" name="quantity_breaks"
                      attrs="{'invisible': [('x_special_pricing','=',False)]}">

                    <group string="Quantity Breaks" name="qb" col="4">


                        <field name="x_partner_qty" string="Quantity Breaks"/>
                        <field name="x_partner_uom" string="Unit of Measure"/>
                        <field name="x_partner_price_per_uom" string="Price Per UOM"/>
                        <field name="x_partner_price_per_value" string="Price Per Value"/>

                    </group>

                </page>
            </xpath>


            <xpath expr="//notebook/page[@name='contact_addresses']//field[@name='child_ids']/form/sheet/group/group[1]//field[@name='country_id']"
                   position="after">
                <field name="x_country_code"/>

            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//field[@name='child_ids']/form/sheet/group/group[1]//field[@name='state_id']"
                   position="replace">
                <field name="state_id" class="o_address_state" placeholder="Territory"
                       options="{'no_open': True, 'no_quick_create': True}"
                       context="{'default_country_id': country_id}"/>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//field[@name='child_ids']/form/sheet/group/group[2]/field['mobile']"
                   position="after">
                <field name="x_fax" attrs="{'invisible': [('type','!=', 'other'),('type','!=', 'invoice')]}"/>

            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']//field[@name='child_ids']/form/sheet/group/group[2]/field['category_id']"
                   position="before">
                <field name="industry_id" string="Class Of Trade"
                       attrs="{'invisible': [('type','!=', 'other'),('type','!=', 'invoice')]}"/>
                <field name="x_publisher" attrs="{'invisible': [('type','!=', 'other')]}"/>
                <field name="x_reference"/>
                <field name="receive_parent_mail"
                       attrs="{'invisible': [('parent_id', '=', False)]}"
                       string="Receive parent mail"/>

            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                  <field name="receive_parent_mail"/>
                    <field name="partner_attachment" widget="many2many_binary"/>

            </xpath>
            <!--  <xpath expr="//notebook/page[@name='contact_addresses']//field[@name='child_ids']/form/sheet//div[1]" position="replace">
             <div attrs="{'invisible': [('type','=', 'private '),('type','=', 'contact')]}">
                                                <div class="o_address_format" name="div_address">
                                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                                    <field name="city" placeholder="City" class="o_address_city"/>
                                                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                                    <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                                </div>
                                            </div>
                                              </xpath>



            -->


        </field>
    </record>
    <record id="custom_partner_view_tree" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="type"/>
            </xpath>
        </field>
    </record>

    <record id="custom_res_partner_industry_view_tree" model="ir.ui.view">
        <field name="name">Industry</field>
        <field name="model">res.partner.industry</field>
        <field name="inherit_id" ref="base.res_partner_industry_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_sales_ind_manager"/>
            </xpath>
        </field>
    </record>

    <record id="custom_res_partner_industry_view_form" model="ir.ui.view">
        <field name="name">Industry</field>
        <field name="model">res.partner.industry</field>
        <field name="inherit_id" ref="base.res_partner_industry_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_sales_ind_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
