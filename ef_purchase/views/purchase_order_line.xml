<odoo>
    <record model="ir.ui.view" id="purchase_order_line_tree">
        <field name="name">Purchase Order Line</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="order_id"/>
                <field name="date_order"/>
                <field name="partner_id" options='{"no_open": True, "no_create": True}'/>
                <field name="product_id" options='{"no_create": True}'/>
                <field name="name"/>
                <field name="price_unit"/>
                <field name="product_qty"/>
                <field name="qty_received"/>
                <field name="qty_invoiced"/>
                <field name="qty_to_invoice"/>
                <field name="remaining_quantity" force_save="1"/>
                <field name="invoice_ids_1" widget="many2many_tags"/>
                <field name="picking_ids_1" widget="many2many_tags"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_purchase_order_line" model="ir.actions.act_window">
        <field name="name">Purchase Order Line</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="purchase_order_line_tree"/>

    </record>

    <menuitem id="menu_purchase_order_line" name="Purchase Order Lines"
              parent="purchase.menu_purchase_root" sequence="15"/>

    <menuitem id="menu_purchase_order_line_sub" name="Purchase Order Lines"
              parent="menu_purchase_order_line"
              action="action_purchase_order_line" sequence="15"/>
</odoo>