    <record id="view_mrp_workcenter_view" model="ir.ui.view">
        <field name="name">mrp.workcenter.branch.form</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view" />
        <field name="arch" type="xml">
                    <field name="alternative_workcenter_ids" position="after">
                        <field name="branch_id"/>
                    </field>
        </field>
    </record>

    <record id="view_mrp_workorder_form" model="ir.ui.view">
        <field name="name">mrp.workorder.branch.form</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
                    <field name="product_id" position="after">
                        <field name="branch_id"/>
                    </field>
        </field>
    </record>

    
