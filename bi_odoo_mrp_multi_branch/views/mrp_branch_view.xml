<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

    <record id="view_mrp_bom_form" model="ir.ui.view">
        <field name="name">mrp.bom.branch.form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="branch_id"/>
            </field>
            
            <xpath expr="//notebook/page/field[@name='bom_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="branch_id"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_mrp_production_form" model="ir.ui.view">
        <field name="name">mrp.production.branch.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="branch_id"/>
            </field>

            <xpath expr="///field[@name='move_raw_ids']/tree/field[@name='product_id']" position="after">
                <field name="branch_id"/>
            </xpath>
        </field>
    </record>




     <record id="mrp_view_stock_production_workorder_inherit" model="ir.ui.view">
        <field name="name">mrp.view.workorder.inherit.raw.tree</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view" />
        <field name="arch" type="xml">
<!--             <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Operation Name</attribute>
            </xpath>

 -->
<!--             <xpath expr="//field[@name='operation_id']" position="attributes">
                <attribute name="domain">
                    ['|', '|', ('bom_id', '=', production_bom_id), ('bom_id', '=', False), ('workcenter_id', '=', workcenter_id)]
                </attribute>
            </xpath> -->
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="branch_id" groups="base.group_no_one"/>
            </xpath>
<!--             <xpath expr="//field[@name='workcenter_id']" position="after">
               <field name="operation_work_id" string="Operation"/>
            </xpath> -->

        </field>
    </record>

