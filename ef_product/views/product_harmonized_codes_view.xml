<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Harmonized Tree View -->
    <record id="product_harmonized_codes_tree_view" model="ir.ui.view">
        <field name="name">product.harmonized.codes.group.tree.view</field>
        <field name="model">product.harmonized.codes</field>
        <field name="arch" type="xml">
            <tree string="Harmonized Codes">
                <field name="name" required="1"/>
                <field name="x_Description"/>
            </tree>
        </field>
    
    <!-- Harmonized CodesForm View -->
    </record>

    <record id="product_harmonized_codes_form_view" model="ir.ui.view">
        <field name="name">product.harmonized.codes.form.view</field>
        <field name="model">product.harmonized.codes</field>
        <field name="arch" type="xml">
            <form string="Harmonized Codes">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="x_Description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Harmonized Codes Search View -->
    <record id="product_harmonized_codes_search_view" model="ir.ui.view">
        <field name="name">product.harmonized.codes.search.view</field>
        <field name="model">product.harmonized.codes</field>
        <field name="arch" type="xml">
            <search string="Harmonized Codes Group">
                <field name="name" string="Harmonized Codes Group"/>
            </search>
        </field>
    </record>

    <!-- Harmonized Codes Action View -->
    <record id="product_harmonized_codes_action_view" model="ir.actions.act_window">
        <field name="name">Harmonized Codes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.harmonized.codes</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="product_harmonized_codes_tree_view"/>
        <field name="search_view_id" ref="product_harmonized_codes_search_view"/>
    </record>

    <!-- Harmonized Codes Menu View -->
    <menuitem id="product_harmonized_codes_menu_view"
        name="Harmonized Codes"
        action="product_harmonized_codes_action_view"
        parent="stock.menu_stock_config_settings"
        groups="ef_product.group_product_master"
        sequence="4"/>
</odoo>