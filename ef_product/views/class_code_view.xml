<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Labor Items Tree View -->
    <record id="class_code_tree_view" model="ir.ui.view">
        <field name="name">class.code.tree.view</field>
        <field name="model">class.code</field>
        <field name="arch" type="xml">
            <tree string="Class Codes">
                <field name="x_class_code" required="1"/>
                <field name="x_description"/>
            </tree>
        </field>
    </record>
    <record id="class_code_form_view" model="ir.ui.view">
        <field name="name">class.code.form.view</field>
        <field name="model">class.code</field>
        <field name="arch" type="xml">
            <form string="Class Code">
                <sheet>
                    <group>
                        <group>
                            <field name="x_class_code" required="1"/>
                        </group>
                        <group>
                            <field name="x_description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Quantity Search View -->
    <record id="class_code_search_view" model="ir.ui.view">
        <field name="name">class.code.search.view</field>
        <field name="model">class.code</field>
        <field name="arch" type="xml">
            <search string="Class Codes">
                <field name="x_class_code" string="Class Code"/>
            </search>
        </field>
    </record>

    <!-- Product Quantity Action View -->
    <record id="class_code_action_view" model="ir.actions.act_window">
        <field name="name">Class Codes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">class.code</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="class_code_tree_view"/>
        <field name="search_view_id" ref="class_code_search_view"/>
    </record>

    <!-- Product Color Menu View -->
    <menuitem id="class_code_menu_view"
        name="Class Codes"
        action="class_code_action_view"
        parent="stock.menu_stock_config_settings"
        groups="ef_product.group_product_master"
        sequence="4"/>
</odoo>