<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wo_notifications" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wo.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='mrp']" position="inside">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_wo_notifications"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_wo_notifications"/>
                            <div class="text-muted">
                                Enable automatic notifications when a workorder produces less than planned.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('enable_wo_notifications', '=', False)]}">
                        <div class="o_setting_right_pane">
                            <label for="wo_notification_timeframe"/>
                            <div class="text-muted">
                                Choose how far back to look for workorders when sending notifications.
                            </div>
                            <field name="wo_notification_timeframe"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('enable_wo_notifications', '=', False)]}">
                        <div class="o_setting_right_pane">
                            <label for="wo_notification_user_ids"/>
                            <div class="text-muted">
                                Select internal users that should receive the notification emails.
                            </div>
                            <field name="wo_notification_user_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
