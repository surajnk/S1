<?xml version="1.0" ?>

<odoo>
    <record id="mrp_sop_massive_planning_wizard" model="ir.ui.view">
        <field name="name">mrp.sop.massive.planning.wizard</field>
        <field name="model">mrp.sop.massive.planning.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options= "{'color_field': 'color','no_open':True,'no_create':1,'no_create_edit':1}"/>
                        <field name="warehouse_id" groups="stock.group_stock_multi_locations" options="{'no_open':True,'no_create':True}"/>
                    </group>
                    <group>
                        <field name="all_products"/>
                    </group>
                </group>
                <footer>
                    <button type="object" name="get_planning" string="Massive Planning" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_sop_massive_planning" model="ir.actions.act_window">
        <field name="name">SOP Planning</field>
        <field name="res_model">mrp.sop.massive.planning.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_sop_massive_planning_wizard"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mrp_master_production_plan.model_mrp_sales_operations_plan" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>