<?xml version="1.0" encoding="utf-8"?>
     
<odoo>        
    <record id="res_config_settings_view_form" model="ir.ui.view">       
        <field name="name">res.config.settings.view.form.inherit.mrp.master.production.plan</field>      
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
        <xpath expr="//div[@data-key='mrp']" position="inside">
            <h2>Demand Planning</h2>
            <div class="row mt16 o_settings_container">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane"> 
                        <label for="supply_warehouse_id"/>
                        <div class="text-muted">
                        Default Source Warehouse
                        </div>
                        <field name="supply_warehouse_id"/>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="warehouse_id"/>
                        <div class="text-muted">
                        Default Warehouse
                        </div>
                        <field name="warehouse_id"/>
                    </div>
                </div>
            </div>
            <h2>SOP Planning</h2>
            <div class="row mt16 o_settings_container">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">               
                        <label for="number_maximum_lots"/>
                        <div class="text-muted">
                        Maximum number of procurement proposals in SOP Planning for Fixed Lot Method 
                        </div>
                        <field name="number_maximum_lots"/>
                    </div>
                </div>
            </div>
        </xpath>   
        </field>      
     </record>
</odoo>
