<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="mrp_mpp_capacity_form" model="ir.ui.view" >
        <field name="name">mrp.mpp.capacity.form</field>
        <field name="model">mrp.mpp.capacity</field>
        <field name="arch" type="xml">
            <form string="MPP Item Capacity">
            <sheet>
                <div class="oe_button_box" name="button_box">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="active" invisible="1"/>
                </div>
                <group>
                    <group>
                        <field name="MPP_item" string="MPP ID" readonly="1"/>
                        <field name="SOP_item" string="MPP ID" readonly="1"/>
                        <field name="date_planned" widget="date"/>
                        <field name="product_id"/>
                        <field name="product_qty"/>
                        <field name="product_uom_id"/>
                    </group>
                    <group>
                        <field name="workcenter_id"/>
                        <field name="capacity"/>
                        <field name="duration"/>
                    </group>
                </group>
            </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_mpp_capacity_tree" model="ir.ui.view">
        <field name="name">mrp.mpp.capacity.tree</field>
        <field name="model">mrp.mpp.capacity</field>
        <field name="arch" type="xml">
            <tree string="MPP Capacity Items" create="false" edit="false">
                <field name="MPP_item"/>
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="date_planned" widget="date"/>
                <field name="duration"/>
                <field name="capacity"/>
            </tree>
      </field>
    </record>

    <record id="mrp_mpp_capacity_pivot" model="ir.ui.view">
        <field name="name">mrp.mpp.capacity.pivot</field>
        <field name="model">mrp.mpp.capacity</field>
        <field name="arch" type="xml">
            <pivot string="Capacity Plan">
                <field name="date_planned" interval="week" type="col"/>
                <field name="workcenter_id" type="row"/>
                <field name="duration" type="measure"/>
                <field name="capacity" type="measure" avg="weekly capacity"/>
            </pivot>
        </field>
    </record>

    <record id="mrp_mpp_capacity_graph" model="ir.ui.view">
        <field name="name">mrp.mpp.capacity.graph</field>
        <field name="model">mrp.mpp.capacity</field>
        <field name="arch" type="xml">
            <graph string="Capacity Plan">
                <field name="date_planned" interval="week" type="row"/>
                <field name="workcenter_id" type="row"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="filter_mrp_mpp_capacity" model="ir.ui.view">
        <field name="name">mrp.mpp.capacity.filter</field>
        <field name="model">mrp.mpp.capacity</field>
        <field name="arch" type="xml">
            <search>
                <field name="workcenter_id" string="Workcenter" filter_domain="[('name', 'ilike', self)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Work Center" name="groupby_workcenter_id" domain="[]" context="{'group_by': 'workcenter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mrp_mpp_capacity_action" model="ir.actions.act_window">
        <field name="name">MPP Capacity Check</field>
        <field name="res_model">mrp.mpp.capacity</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="context">{'search_default_groupby_workcenter_id': 1}</field>
        <field name="domain">[('SOP_item', '=', False)]</field>
    </record>

    <record model="ir.actions.act_window.view" id="mrp_mpp_capacity_action_pivot_view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="mrp_mpp_capacity_pivot"/>
        <field name="act_window_id" ref="mrp_mpp_capacity_action"/>
    </record>

    <record model="ir.actions.act_window.view" id="mrp_mpp_capacity_action_tree_view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="mrp_mpp_capacity_tree"/>
        <field name="act_window_id" ref="mrp_mpp_capacity_action"/>
    </record>

    <record model="ir.actions.act_window.view" id="mrp_mpp_capacity_action_graph_view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="mrp_mpp_capacity_graph"/>
        <field name="act_window_id" ref="mrp_mpp_capacity_action"/>
    </record>
</odoo>
