<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_dpi_po_creation_form" model="ir.ui.view">
        <field name="model">mrp.dpi.po.creation</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="vendor_id" required="True" domain="[('is_company','=', True)]"/>
                    </group>
                </group>
                <footer>
                    <button name="get_purchase_order" string="PO Creation" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dpi_po_creation" model="ir.actions.act_window">
        <field name="name">PO Creation</field>
        <field name="res_model">mrp.dpi.po.creation</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dpi_po_creation_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mrp_master_production_plan.model_mrp_distribution_procurement"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
