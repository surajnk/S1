<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record model="ir.module.category" id="module_category_master_production_plan">
        <field name="name">Master Production Plan</field>
        <field name="parent_id" ref="base.module_category_manufacturing"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_mpp_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="category_id" ref="module_category_master_production_plan" />
    </record>

    <record id="group_mpp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('mrp_master_production_plan.group_mpp_user')),(4, ref('mrp.group_mrp_user'))]"/>
        <field name="category_id" ref="module_category_master_production_plan" />
    </record>

    <record id="mrp.group_mrp_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mpp_user'))]" />
    </record>
</odoo>
