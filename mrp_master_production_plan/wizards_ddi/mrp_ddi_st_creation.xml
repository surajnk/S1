<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_ddi_st_creation_form" model="ir.ui.view">
        <field name="model">mrp.ddi.st.creation</field>
        <field name="arch" type="xml">
            <form>
                <group>
                </group>
                <footer>
                    <button name="get_stock_transfer_document" string="ST Creation" type="object" class="oe_highlight"/>
