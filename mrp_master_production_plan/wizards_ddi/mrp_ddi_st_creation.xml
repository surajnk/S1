        <field name="res_model">mrp.ddi.st.creation</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ddi_st_creation_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mrp_master_production_plan.model_mrp_distribution_deployment"/>
        <field name="binding_view_types">list</field>
    </record>
