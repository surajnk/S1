<odoo>
    <record id="view_wo_roll_summary_wizard_form_enhanced" model="ir.ui.view">
        <field name="name">wo.roll.summary.wizard.form.enhanced</field>
        <field name="model">wo.roll.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Workorder Rolls Summary" class="o_form_full">
                <group>
                    <field name="lot_id"/>
                    <field name="production_id"/>
                    <button string="Get Workorders" type="object" name="action_search" class="btn btn-primary oe_highlight"/>
                </group>
                <notebook>
                    <page string="Workorders">
                        <field name="workorder_line_ids" widget="one2many_list" nolabel="1">
                            <tree editable="false" create="false" delete="false">
                                <field name="workorder_id"/>
                            </tree>
                            <form string="Workorder Details">
                                <group>
                                    <field name="workorder_id" readonly="1"/>
                                </group>
                                <group string="Output Rolls">
                                    <field name="roll_line_ids" widget="one2many_list" nolabel="1">
                                        <tree editable="false" create="false" delete="false">
                                            <field name="prev_roll_id"/>
                                            <field name="product_id"/>
                                            <field name="roll_id"/>
                                            <field name="remained_qty" widget="float" string="Qty on Roll"/>
                                            <field name="consumed_qty"/>
                                            <field name="date"/>
                                            <field name="user_id"/>
                                        </tree>
                                    </field>
                                </group>
                                <group string="Final Output Rolls">
                                    <field name="final_roll_line_ids" widget="one2many_list" nolabel="1">
                                        <tree editable="false" create="false" delete="false">
                                            <field name="previous_roll_id"/>
                                            <field name="user_id"/>
                                            <field name="remained_qty"/>
                                            <field name="is_fully_consumed"/>
                                            <field name="consumed_qty"/>
                                            <field name="total_qty"/>
                                            <field name="yards_qty"/>
                                            <field name="date"/>
                                        </tree>
                                    </field>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Print PDF" type="object" name="print_report" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
