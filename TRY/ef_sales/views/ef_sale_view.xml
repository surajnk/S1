    <!--Sale Orientation-->
    <record id="sale_orientation_tree" model="ir.ui.view">
        <field name="name">sale.orientation.tree</field>
        <field name="model">sale.orientation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" required="1"/>
                <field name="x_orientation_uom"/>
            </tree>
        </field>
    </record>

    <record id="sale_orientation_form" model="ir.ui.view">
        <field name="name">sale.orientation.form</field>
        <field name="model">sale.orientation</field>
        <field name="arch" type="xml">
            <form string="Orientation">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="x_orientation_uom"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_orientation_search_view" model="ir.ui.view">
        <field name="name">sale.orientation.search.view</field>
        <field name="model">sale.orientation</field>
        <field name="arch" type="xml">
            <search string="Orientation">
                <field name="name" string="Orientation"/>
            </search>
        </field>
    </record>

    <!-- Product Quantity Action View -->
    <record id="sale_orientation_action_view" model="ir.actions.act_window">
        <field name="name">Sale Orientation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.orientation</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="sale_orientation_tree"/>
        <field name="search_view_id" ref="sale_orientation_search_view"/>
    </record>

    <!-- Product Color Menu View -->
    <menuitem id="sale_orientation_menu_view"
        name="Orientation"
        action="sale_orientation_action_view"
        parent="sale.menu_sale_config"
        sequence="4"/>

    <!--Sale Order Warehouse-->
    <record id="sale_orientation_tree_inv_route" model="ir.ui.view">
        <field name="name">sale.order.invis.route</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='picking_policy']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_tree_view_inherit_efatc" model="ir.ui.view">
        <field name="name">sale.order.line.tree.view.inherit.efatc</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_id']" position="after">
                <field name="x_mrp_line_ship_date"/>
                <field name="x_mrp_line_revised_ship_date"/>
            </xpath>
        </field>
    </record>
</odoo>
