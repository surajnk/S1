<odoo>
    <record id="mrp_production_allowance_acknowledged_action" model="ir.actions.server">
        <field name="name">Mark Allowances Acknowledged</field>
        <field name="state">code</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list,form</field>
        <field name="code">
action = env['mrp.production'].browse(env.context.get('active_ids', [])).action_allowance_acknowledged()
        </field>
    </record>
</odoo>
