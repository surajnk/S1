<odoo>
    <record id="view_crm_complaints_wizard_form" model="ir.ui.view">
        <field name="name">crm.complaints.wizard.form</field>
        <field name="model">crm.complaints.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Invoice Lines">
                <group>
                    <field name="complaint_id" invisible="1"/>
                    <field name="move_type_filter"/>
                    <field name="complaints_lines_option"/>
                    <field name="invoice_line_ids" widget="many2many_tags" context="{'default_move_type_filter': move_type_filter}"/>

                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_complaints_wizard" model="ir.actions.act_window">
        <field name="name">CRM Complaints Wizard</field>
        <field name="res_model">crm.complaints.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>