<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="mrp_production_form_view_component_workorder_line_m2m" model="ir.ui.view">
      <field name="name">mrp.production.form.component.workorder.line.m2m</field>
      <field name="model">mrp.production</field>
      <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">

          <xpath expr="//page[@name='components']//field[@name='move_raw_ids']/tree/field[@name='product_uom_qty']"
                 position="after">
            <field name="component_workorder_ids"
                   widget="many2many_tags"
                   options="{'no_create': True}"
                   domain="[('production_id', '=', parent.id)]"
                   attrs="{'readonly': [('parent.state', 'in', ['cancel', 'done'])]}"/>
            <field name="curr_comp"/>
          </xpath>

        </field>
    </record>

  </data>
</odoo>
