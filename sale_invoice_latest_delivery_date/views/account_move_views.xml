<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_latest_delivery_date" model="ir.ui.view">
        <field name="name">account.move.form.latest.delivery.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="latest_delivery_date" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
                <field name="has_credits" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
                <field name="email_invoice" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
