<odoo>
    <record id="view_mrp_workorder_schedule_wizard" model="ir.ui.view">
        <field name="name">mrp.workorder.schedule.wizard.form</field>
        <field name="model">mrp.workorder.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Workorder Schedule Report" class="o_form_label">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_workorder_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Workorder Schedule Report</field>
        <field name="res_model">mrp.workorder.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mrp_workorder_schedule_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
