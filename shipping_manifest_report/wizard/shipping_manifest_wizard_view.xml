<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipping_manifest_wizard_form" model="ir.ui.view">
        <field name="name">shipping.manifest.wizard.form</field>
        <field name="model">shipping.manifest.wizard</field>
        <field name="arch" type="xml">
            <form string="Shipping Manifest Report">
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Print"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shipping_manifest_wizard" model="ir.actions.act_window">
        <field name="name">Shipping Manifest Report</field>
        <field name="res_model">shipping.manifest.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
