<odoo>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">view.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="confirm_mrquestt" string="Mark Material Request Done" type="object" class="btn-primary"
                        attrs="{'invisible': [('done_mrequest', '=', True)]}"/>
            </xpath>
            <xpath expr="//field[@name='origin']"
                   position="after">
                <field name="mrequest_id" string="Material Request"/>
                <field name="done_mrequest"/>
            </xpath>
        </field>
    </record>
</odoo>