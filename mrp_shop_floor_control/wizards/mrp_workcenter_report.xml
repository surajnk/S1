<odoo>
    <record id="work_order_print_form" model="ir.ui.view">
        <field name="name">Work Order Print</field>
        <field name="model">mro.workcenter.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="work_ceter_id"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                 <footer>
                    <button name="print_workorder_report" type="object" string="Print" class="btn-primary"/>
                    <button string="Close" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_workcenter_print_report" model="ir.actions.act_window">
        <field name="name">Production Timesheet</field>
        <field name="res_model">mro.workcenter.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_shop_floor_control.work_order_print_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_mrp_workcenter_print_report"
            parent="mrp.menu_mrp_reporting"
            action="action_mrp_workcenter_print_report"
            groups="mrp.group_mrp_user" name="Work Order Print" sequence="70"/>
</odoo>