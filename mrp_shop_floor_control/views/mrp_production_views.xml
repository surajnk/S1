<?xml version="1.0"?>

<odoo>
    <record id="mrp_production_tree_view" model="ir.ui.view">
        <field name="name">mrp.production.tree</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="date_planned_start_pivot" optional="hide"/>
                <field name="date_planned_finished_pivot" optional="hide"/>
                <field name="date_planned_start_wo" optional="hide"/>
                <field name="date_planned_finished_wo" optional="hide"/>
                <field name="date_actual_start_wo" optional="hide"/>
                <field name="date_actual_finished_wo" optional="hide"/>
            </field>
            <field name="date_planned_start" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="date_deadline" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <button name="button_mark_done" position="after">
                <button name="%(action_mrp_confirmation)d" type="action" string="WO Confirmation" attrs="{'invisible': ['|', '|', ('state', 'in', ('draft','done','cancel')),('workorder_ids', '=', []),('wo_confirmation','=', False)]}" class="oe_highlight"/>
            </button>
            <button name="button_plan" position="attributes">
                <attribute name="string">Schedule WOs</attribute>
                <!-- <attribute name="attrs">{'invisible': ['|',('state', '!=', 'confirmed'), ('workorder_ids', '=', [])]}</attribute> -->
            </button>
            <button name="button_unplan" position="attributes">
                <attribute name="string">Unschedule WOs</attribute>
                <!-- <attribute name="attrs">{'invisible': ['|',('state', '!=', 'confirmed'), ('workorder_ids', '=', [])]}</attribute> -->
            </button>
            <field name="workorder_ids" position="before">
                <field name="is_scheduled" invisible="1"/>
                <button name="action_capacity_check" type="object" string="Capacity Load" class="oe_highlight"/>
                </field>
            <field name="user_id" position="before">
                <label for="date_planned_start_pivot" string="Planned Dates" invisible="1" attrs="{'invisible': [('origin', '!=', False)]}"/>
                <div class="o_row" invisible="1" attrs="{'invisible': [('origin', '!=', False)]}">
                    <field name="date_planned_start_pivot" invisible="1" attrs="{'readonly': [('is_scheduled', '!=', False)]}" decoration-warning="state not in ('done', 'cancel') and date_planned_start_pivot &lt; now" decoration-danger="state not in ('done', 'cancel') and date_planned_start_pivot &lt; current_date" decoration-bf="state not in ('done', 'cancel') and (date_planned_start_pivot &lt; current_date or date_planned_start_pivot &lt; now)"/>
                    <strong attrs="{'invisible': [('date_planned_finished_pivot', '=', False)]}" class="mr8">to</strong>
                    <field name="date_planned_finished_pivot" invisible="1" attrs="{'readonly': [('is_scheduled', '!=', False)]}"/>
                    <field name="wo_confirmation" invisible="1"/>
                </div>
                <label for="date_planned_start_wo" string="Scheduled Dates" attrs="{'invisible': [('state', 'in', ('draft', 'done', 'cancel'))]}"/>
                <div class="o_row" attrs="{'invisible': [('state', 'in', ('draft', 'done', 'cancel'))]}">
                    <field name="date_planned_start_wo"/>
                    <!-- <field name="date_planned_start_wo" attrs="{'readonly': [('state', 'not in', ('confirmed',))]}"/> -->
                    <strong attrs="{'invisible': [('date_planned_finished_wo', '=', False)]}" class="mr8">to</strong>
                    <field name="date_planned_finished_wo" attrs="{'readonly': [('move_raw_ids', '!=', [])]}"/>
                </div>
                <label for="date_actual_start_wo" string="Actual Dates" attrs="{'invisible': [('date_actual_start_wo', '=', False)]}"/>
                <div class="o_row" attrs="{'invisible': [('date_actual_start_wo', '=', False)]}">
                    <field name="date_actual_start_wo" readonly="1"/>
                    <strong attrs="{'invisible': [('date_actual_finished_wo', '=', False)]}" class="mr8">to</strong>
                    <field name="date_actual_finished_wo" readonly="1"/>
                </div>
            </field>
            <label for="date_planned_start" position="attributes">
                <attribute name="invisible">1</attribute>
            </label>
            <field name="date_planned_start" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Put Up">
                    <group>
                        <!-- <group>
                            <field name="skip_split" string="Skip to split put up"/>
                        </group> -->
                        <group>
                            <field name="x_dynamic_putup" string="Dynamic Put-ups"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="put_up_rolls"/>
                            <label for="uom_put_up"/>
                            <div>
                                <field name="uom_put_up" class="oe_inline"/> - <field name="put_up_uom_name"/>
                            </div>
                            <field name="addtnl_put_ups"/>
                        </group>
                        <group>
                            <field name="outs"/>
                            <field name="put_up_size"/>
                        </group>
                    </group>
<!--                    <button name="generate_finish_move_line" type="object" string="Generate Finish Move Line"-->
<!--                                class="oe_highlight"/>-->
                    <group>
                        <field name="finished_move_line_ids" nolabel="1">
                            <tree create="false">
                                <field name="product_id"/>
                                <field name="lot_id"/>
                                <field name="qty_done"/>
                                <field name="product_uom_id"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='forecast_availability']" position="after">
                <button name="open_on_hand_qty" type="object" class="fa fa-fw o_button_icon fa-cubes"/>
            </xpath>
            <xpath expr="//label[@for='lot_producing_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='lot_producing_id']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_producing_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_generate_serial']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_wo_roll_line_tree_view" model="ir.ui.view">
        <field name="name">mrp.wo.roll.line.tree</field>
        <field name="model">mrp.wo.roll.line</field>
        <field name="arch" type="xml">
            <tree string="Roll Label Print" editable="bottom">
                <field name="workorder_id" invisible="1"/>
                <field name="prev_roll_ids" invisible="1"/>
                <field name="prev_roll_id" domain="[('id', 'in', prev_roll_ids)]" context="{'workorder_id': workorder_id}"/>
                <field name="prev_roll_remained_qty"/>
                <field name="full_consumed"/>
                <!-- <field name="prev_roll_id" context="{'workorder_id': workorder_id}"/> -->
                <field name="roll_id" required="1" domain="[('name', '=', '')]" context="{'get_default_roll': True}"/>
                <field name="date" readonly="1"/>
                <field name="quantity" required="1"/>
                <!-- <field name="workorder_id" invisible="1"/> -->
                <field name="prev_work_order_id" invisible="1"/>
            </tree>
        </field>
    </record>

</odoo>