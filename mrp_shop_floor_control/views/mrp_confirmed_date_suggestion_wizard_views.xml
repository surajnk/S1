<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_mrp_confirmed_date_suggestion_wizard_form" model="ir.ui.view">
    <field name="name">mrp.confirmed.date.suggestion.wizard.form</field>
    <field name="model">mrp.confirmed.date.suggestion.wizard</field>
    <field name="arch" type="xml">
      <form string="Suggested Confirmed Dates">
        <group>
          <field name="production_id" readonly="1"/>
          <field name="calculation_mode" widget="radio"/>
          <field name="cutoff_time"/>
          <field name="suggestion_count"/>
        </group>

        <footer>
          <button name="action_compute" type="object" string="Compute Suggestions" class="btn-primary"/>
          <button string="Close" special="cancel" class="btn-secondary"/>
        </footer>

        <separator string="Suggestions"/>
        <field name="line_ids" nolabel="1" readonly="1">
          <tree>
            <field name="mode_note"/>
            <field name="workorder_id"/>
            <field name="workcenter_id"/>
            <field name="slot_start"/>
            <field name="slot_end"/>
            <field name="chain_finish"/>
            <field name="suggested_confirmed_date"/>
            <field name="suggested_deadline"/>
          </tree>
        </field>
      </form>
    </field>
  </record>

  <!-- Add button on MO form -->
  <record id="mrp_production_form_inherit_suggest_confirmed_dates" model="ir.ui.view">
    <field name="name">mrp.production.form.inherit.suggest.confirmed.dates</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_confirmed_date_suggestions"
                type="object"
                string="Suggest Confirmed Dates"
                class="btn-secondary"
                attrs="{'invisible': [('state', 'in', ['done','cancel'])]}"/>
      </xpath>
    </field>
  </record>

</odoo>
